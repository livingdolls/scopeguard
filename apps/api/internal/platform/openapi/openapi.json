{
  "openapi": "3.0.3",
  "info": {
    "title": "ScopeGuard API",
    "version": "1.0.0",
    "description": "HTTP API for identity, organizations, and tenant authorization. Protected endpoints require a Bearer access token obtained from POST /v1/auth/login."
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Local development" }
  ],
  "tags": [
    { "name": "System", "description": "Health and readiness checks" },
    { "name": "Identity", "description": "Registration, email verification, and authentication" },
    { "name": "Organizations", "description": "Organization management" },
    { "name": "Authorization", "description": "Organization roles and permission catalog" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": ["System"],
        "operationId": "getHealth",
        "summary": "Check API health",
        "security": [],
        "responses": {
          "200": {
            "description": "The API is running. This check does not query the database.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "status": "ok" }
              }
            }
          }
        }
      }
    },
    "/v1/ready": {
      "get": {
        "tags": ["System"],
        "operationId": "getReadiness",
        "summary": "Check database readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "The database is reachable.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadinessResponse" },
                "example": { "status": "ready" }
              }
            }
          },
          "503": {
            "description": "The database is unavailable or the readiness check timed out.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadinessResponse" },
                "example": { "status": "not_ready" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": ["Identity"],
        "operationId": "registerUser",
        "summary": "Register a user",
        "description": "Queues email verification for a new account. Existing email addresses receive the same accepted response. Requires application/json, rejects unknown fields, and limits the body to 16 KiB. Limited to 5 requests per IP per 15 minutes.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "example": { "email": "user@example.com", "password": "scopeguard example passphrase" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Registration accepted without revealing whether the email is already registered.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RegistrationResponse" },
                "example": { "message": "If the request can be processed, verification instructions will be sent" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/RequestTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/auth/verify-email": {
      "post": {
        "tags": ["Identity"],
        "operationId": "verifyEmail",
        "summary": "Verify an email address",
        "description": "Consumes the single-use verification token delivered by email. Tokens expire after 24 hours. Requires application/json, rejects unknown fields, and limits the body to 16 KiB. Limited to 10 requests per IP per 5 minutes.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyEmailRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Email verified. The response has no body." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/RequestTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": ["Identity"],
        "operationId": "loginUser",
        "summary": "Log in and obtain an access token",
        "description": "Only active, verified accounts can log in. Access tokens expire after 15 minutes. Requires application/json, rejects unknown fields, and limits the body to 16 KiB. Limited to 20 requests per IP per 5 minutes and 5 requests per normalized email per 5 minutes.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "email": "user@example.com", "password": "scopeguard example passphrase" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Use access_token as the Bearer token for protected endpoints.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "Invalid credentials or an account that cannot authenticate.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "invalid credentials" }
              }
            }
          },
          "413": { "$ref": "#/components/responses/RequestTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": ["Identity"],
        "operationId": "getCurrentUser",
        "summary": "Get the authenticated user",
        "responses": {
          "200": {
            "description": "The current user's profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserProfile" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/organizations": {
      "post": {
        "tags": ["Organizations"],
        "operationId": "createOrganization",
        "summary": "Create an organization",
        "description": "Creates an organization owned by the authenticated user. Requires application/json, rejects unknown fields, and limits the body to 16 KiB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrganizationRequest" },
              "example": { "name": "Example Organization", "slug": "example-org" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The organization was created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Organization" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "The organization slug is already in use.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "organization already exists" }
              }
            }
          },
          "413": { "$ref": "#/components/responses/RequestTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/InternalServerError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/organizations/{organization_id}/permissions": {
      "get": {
        "tags": ["Authorization"],
        "operationId": "listPermissions",
        "summary": "List the permission catalog",
        "description": "Returns the permission catalog after checking that the authenticated user has permission:read in the selected organization.",
        "parameters": [{ "$ref": "#/components/parameters/OrganizationID" }],
        "responses": {
          "200": {
            "description": "The permission catalog.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PermissionsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/organizations/{organization_id}/roles": {
      "get": {
        "tags": ["Authorization"],
        "operationId": "listRoles",
        "summary": "List organization roles",
        "description": "Requires role:read in the selected organization.",
        "parameters": [{ "$ref": "#/components/parameters/OrganizationID" }],
        "responses": {
          "200": {
            "description": "The organization's roles.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RolesResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "post": {
        "tags": ["Authorization"],
        "operationId": "createRole",
        "summary": "Create a custom organization role",
        "description": "Requires role:create in the selected organization. Effective permissions are read from PostgreSQL on each request. Requires application/json, rejects unknown fields and reserved owner/member slugs, and limits the body to 16 KiB.",
        "parameters": [{ "$ref": "#/components/parameters/OrganizationID" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRoleRequest" },
              "example": { "name": "Content Editor", "slug": "content_editor" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The custom role was created without permissions.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Role" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "The organization no longer exists when role creation begins.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "The role slug is already in use in this organization.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "role slug already exists" }
              }
            }
          },
          "413": { "$ref": "#/components/responses/RequestTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/organizations/{organization_id}/roles/{role_id}/permissions": {
      "post": {
        "tags": ["Authorization"],
        "operationId": "grantRolePermission",
        "summary": "Grant a permission to a custom role",
        "description": "Requires role:update and the permission being granted in the selected organization. Effective permissions are checked against PostgreSQL on each request. The target role must belong to this organization and must not be an owner or member system role. The permission must exist in the permission catalog. Repeating an authorized grant is idempotent. Requires application/json, rejects unknown fields and trailing JSON values, and limits the body to 16 KiB.",
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationID" },
          { "$ref": "#/components/parameters/RoleID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GrantRolePermissionRequest" },
              "example": { "permission_code": "member:invite" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The permission was already assigned. No assignment was added; added is false.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GrantRolePermissionResponse" },
                "example": {
                  "role_id": "420f90b8-91e2-46e8-8a46-ac58c57f56aa",
                  "permission_code": "member:invite",
                  "added": false
                }
              }
            }
          },
          "201": {
            "description": "The permission was assigned to the custom role; added is true.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GrantRolePermissionResponse" },
                "example": {
                  "role_id": "420f90b8-91e2-46e8-8a46-ac58c57f56aa",
                  "permission_code": "member:invite",
                  "added": true
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "The target role does not belong to this organization, the permission is not registered, or the organization no longer exists when the grant begins.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "roleNotFound": { "value": { "error": "role not found" } },
                  "permissionNotFound": { "value": { "error": "permission not found" } },
                  "organizationNotFound": { "value": { "error": "organization not found" } }
                }
              }
            }
          },
          "409": {
            "description": "Permissions on owner and member system roles cannot be modified.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "system role immutable" }
              }
            }
          },
          "413": { "$ref": "#/components/responses/RequestTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/organizations/{organization_id}/roles/{role_id}/permissions/{permission_code}": {
      "delete": {
        "tags": ["Authorization"],
        "operationId": "revokeRolePermission",
        "summary": "Revoke a permission from a custom role",
        "description": "Requires role:update and the permission being revoked in the selected organization. Effective permissions are checked against PostgreSQL on each request. The target must be a custom role in this organization and the permission must exist in the catalog. An authorized request is idempotent: it returns HTTP 200 with removed true when an assignment was deleted, or false when it was already absent. Supply permission_code in the path. No request body or Content-Type header is required.",
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationID" },
          { "$ref": "#/components/parameters/RoleID" },
          { "$ref": "#/components/parameters/PermissionCode" }
        ],
        "responses": {
          "200": {
            "description": "The authorized revoke completed. removed indicates whether an assignment was deleted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RevokeRolePermissionResponse" },
                "examples": {
                  "removed": {
                    "value": {
                      "role_id": "420f90b8-91e2-46e8-8a46-ac58c57f56aa",
                      "permission_code": "member:invite",
                      "removed": true
                    }
                  },
                  "alreadyAbsent": {
                    "value": {
                      "role_id": "420f90b8-91e2-46e8-8a46-ac58c57f56aa",
                      "permission_code": "member:invite",
                      "removed": false
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": {
            "description": "The target role does not exist in the selected organization, the permission is not registered, or the organization no longer exists when the revoke begins.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "examples": {
                  "roleNotFound": { "value": { "error": "target role not found" } },
                  "permissionNotFound": { "value": { "error": "permission not found" } },
                  "organizationNotFound": { "value": { "error": "organization not found" } }
                }
              }
            }
          },
          "409": {
            "description": "Permissions on owner and member system roles cannot be modified.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "system role is immutable" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Use access_token from POST /v1/auth/login."
      }
    },
    "parameters": {
      "OrganizationID": {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "description": "A non-zero organization UUID.",
        "schema": { "type": "string", "format": "uuid" },
        "example": "b6b567a8-5354-4b95-9ed7-8bcc69c5c2f9"
      },
      "RoleID": {
        "name": "role_id",
        "in": "path",
        "required": true,
        "description": "A non-zero UUID of a custom role belonging to the selected organization.",
        "schema": { "type": "string", "format": "uuid" },
        "example": "420f90b8-91e2-46e8-8a46-ac58c57f56aa"
      },
      "PermissionCode": {
        "name": "permission_code",
        "in": "path",
        "required": true,
        "description": "A registered resource:action permission that the actor holds in the selected organization.",
        "schema": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z][a-z0-9_]{0,62}:[a-z][a-z0-9_]{0,62}$"
        },
        "example": "member:invite"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["ready", "not_ready"] }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "description": "Trimmed and converted to lowercase. Maximum 320 bytes after normalization."
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 15,
            "maxLength": 1024,
            "description": "At least 15 Unicode characters and at most 1024 UTF-8 bytes."
          }
        }
      },
      "RegistrationResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "The verification token from the email link."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 320 },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 1,
            "maxLength": 1024,
            "description": "Maximum 1024 UTF-8 bytes."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["access_token", "token_type", "expires_at"],
        "properties": {
          "access_token": { "type": "string", "description": "JWT access token." },
          "token_type": { "type": "string", "enum": ["Bearer"] },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "UserProfile": {
        "type": "object",
        "required": ["id", "email"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "CreateOrganizationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slug"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed before validation; 1 to 160 Unicode characters after trimming."
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      },
      "Organization": {
        "type": "object",
        "required": ["id", "name", "slug", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Permission": {
        "type": "object",
        "required": ["code", "resource", "action", "description"],
        "properties": {
          "code": { "type": "string", "example": "permission:read" },
          "resource": { "type": "string", "example": "permission" },
          "action": { "type": "string", "example": "read" },
          "description": { "type": "string" }
        }
      },
      "PermissionsResponse": {
        "type": "object",
        "required": ["permissions"],
        "properties": {
          "permissions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Permission" }
          }
        }
      },
      "CreateRoleRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slug"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed before validation; 1 to 80 Unicode characters after trimming."
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "description": "The system role slugs owner and member are reserved."
          }
        }
      },
      "GrantRolePermissionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["permission_code"],
        "properties": {
          "permission_code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 127,
            "pattern": "^[a-z][a-z0-9_]{0,62}:[a-z][a-z0-9_]{0,62}$",
            "description": "A registered resource:action permission that the actor holds in the selected organization.",
            "example": "member:invite"
          }
        }
      },
      "GrantRolePermissionResponse": {
        "type": "object",
        "required": ["role_id", "permission_code", "added"],
        "properties": {
          "role_id": { "type": "string", "format": "uuid" },
          "permission_code": { "type": "string", "example": "member:invite" },
          "added": {
            "type": "boolean",
            "description": "True for a new assignment (HTTP 201); false when the assignment already exists (HTTP 200)."
          }
        }
      },
      "RevokeRolePermissionResponse": {
        "type": "object",
        "required": ["role_id", "permission_code", "removed"],
        "properties": {
          "role_id": { "type": "string", "format": "uuid" },
          "permission_code": { "type": "string", "example": "member:invite" },
          "removed": {
            "type": "boolean",
            "description": "True when an assignment was deleted; false when the assignment was already absent. Both outcomes return HTTP 200 after authorization."
          }
        }
      },
      "Role": {
        "type": "object",
        "required": ["id", "organization_id", "name", "slug", "is_system", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "organization_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "is_system": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "RolesResponse": {
        "type": "object",
        "required": ["roles"],
        "properties": {
          "roles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Role" }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid JSON, invalid fields, invalid organization or role UUID, invalid permission code, or an invalid or expired verification token.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is required, the token is invalid or expired, or the user is not active.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "The user does not have the required permission in this organization.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": "access denied" }
          }
        }
      },
      "RequestTooLarge": {
        "description": "The JSON request body exceeds 16 KiB.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": "request body too large" }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type must be application/json.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests. Retry after the number of seconds in Retry-After.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": "too many requests" }
          }
        }
      },
      "InternalServerError": {
        "description": "An internal operation failed.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": "internal server error" }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Authentication, authorization, rate limiting, or a backing service is temporarily unavailable.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
