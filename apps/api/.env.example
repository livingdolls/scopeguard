HTTP_ADDR=:8080
DATABASE_URL=postgres://scopeguard:scopeguard_dev@localhost:5433/scopeguard?sslmode=disable
DB_MAX_CONNECTIONS=5

JWT_ACCESS_SECRET_B64=
JWT_ISSUER=scopeguard
JWT_AUDIENCE=scopeguard-api

EMAIL_OUTBOX_KEY_B64=
EMAIL_OUTBOX_KEY_ID=v1

AUTH_RATE_LIMIT_KEY_B64=

# Empty means no reverse proxies are trusted.
TRUSTED_PROXY_CIDRS=

# SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Verification landing page
EMAIL_VERIFICATION_URL=https://app.your-domain.com/verify-email

# Worker
EMAIL_WORKER_CONCURRENCY=2

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DATABASE_URL}
GOOSE_MIGRATION_DIR=./migrations